# -----------------------------------------------------------------------------
# BSBRA platform — environment variables
# Copy to .env.local for development; set the same keys in your hosting provider.
# Leave the Supabase keys empty to run the preview build with sample content.
# -----------------------------------------------------------------------------

# Public site URL (no trailing slash). Used for canonical links, sitemap and auth e-mails.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_…) or the legacy anon key — both work.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only secret key (sb_secret_…) or legacy service_role key.
# Needed only for inviting users from Admin → Users. NEVER expose it to the browser.
SUPABASE_SECRET_KEY=

# Allow visitors to request an account from the sign-in page (true/false).
NEXT_PUBLIC_ALLOW_ACCESS_REQUESTS=true

# Optional: Google Analytics 4 measurement ID (G-XXXXXXXXXX) and Search Console verification.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
